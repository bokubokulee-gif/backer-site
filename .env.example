# Public Google Analytics 4 Measurement ID (for example, G-XXXXXXXXXX).
GA4_MEASUREMENT_ID=

# Server-only PostgreSQL connection string. Use Supabase's pooled connection in production.
DATABASE_URL=

# Database TLS controls. Keep TLS required unless a local test database explicitly needs otherwise.
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase project URL and server-only service-role key, if the API implementation uses them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must exactly match POLICY_VERSION in js/analytics-core.js; bump both with reviewed privacy copy.
ANALYTICS_CONSENT_POLICY_VERSION=2026-08-20

# At least 32 random bytes used for HMAC-SHA-256 pseudonymous hashes, plus a rotation label.
ANALYTICS_HASH_SECRET=
ANALYTICS_HASH_KEY_VERSION=v1

# Base64-encoded 32-byte AES-256-GCM key and rotation label. Leave the key empty while raw-IP mode is off.
ANALYTICS_IP_ENCRYPTION_KEY_B64=
ANALYTICS_IP_ENCRYPTION_KEY_VERSION=v1

# Optional JSON map of retained encryption key versions used only during a controlled key rotation.
ANALYTICS_IP_ENCRYPTION_KEYS_B64_JSON=

# Exact-IP storage is intentionally disabled unless legal review and owner approval are complete.
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_RAW_IP_RETENTION_DAYS=7
ANALYTICS_EVENT_RETENTION_DAYS=90

# Server-compatible scrypt hash of the administrator password; never place the password itself here.
ANALYTICS_ADMIN_PASSWORD_HASH=

# At least 32 random bytes used to sign short-lived administrator sessions.
ANALYTICS_SESSION_SECRET=

# Administrator audit label and secure-session lifetimes in seconds.
ANALYTICS_ADMIN_IDENTITY=backer-admin
ANALYTICS_ADMIN_SESSION_TTL_SECONDS=28800
ANALYTICS_ADMIN_SESSION_IDLE_SECONDS=1800
ANALYTICS_ADMIN_REAUTH_SECONDS=300

# Comma-separated exact origins only, including scheme and port. Never use *.
ANALYTICS_ALLOWED_ORIGINS=

# Per-minute first-party collector limits.
ANALYTICS_IP_RATE_LIMIT_PER_MINUTE=300
ANALYTICS_VISITOR_RATE_LIMIT_PER_MINUTE=120

# Public aggregate counter. The API returns only recorded human views; there is no
# baseline or scheduled synthetic increment.
PUBLIC_VIEW_COUNTS_ENABLED=false

# Random bearer secret checked by the protected daily retention endpoint.
CRON_SECRET=

# Market 2 official provider connectors. These values are server-only.
# The public demo falls back to a timestamped snapshot when a credential is absent.
X_BEARER_TOKEN=
X_WOEID=1
X_COMMERCIAL_USE_APPROVED=false

YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
# Keep false unless YouTube has approved Backer's exact derived-metrics use in writing.
YOUTUBE_DERIVED_METRICS_APPROVED=false

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_DISCOVERY_HANDLES=
INSTAGRAM_APP_REVIEW_APPROVED=false
META_GRAPH_VERSION=v25.0

GITHUB_TOKEN=
GITHUB_PUBLIC_ONLY_TOKEN_APPROVED=false

# Backer creator discovery runs only official/public server-side adapters. It never accepts browser cookies.
# Same-origin POST search is limited per IP. Use a distinct 32+ byte HMAC secret in production;
# with DATABASE_URL, the limiter uses the atomic analytics_rate_limits table. If either durable input is
# unavailable in production, search serves only the bundled catalog and suppresses cache, providers, and AI.
BACKER_DISCOVERY_RATE_LIMIT_SECRET=
# Opaque pagination cursors require a separate 32+ byte HMAC secret in production.
BACKER_DISCOVERY_CURSOR_SECRET=
BACKER_DISCOVERY_RATE_LIMIT_PER_MINUTE=30
BACKER_DISCOVERY_PROVIDER_TIMEOUT_MS=4000

# Optional provider-specific overrides. Existing GITHUB_TOKEN, YOUTUBE_API_KEY and X_BEARER_TOKEN
# above remain supported fallbacks. GH_TOKEN is also a standard GitHub server-token fallback.
BACKER_GITHUB_TOKEN=
GH_TOKEN=
BACKER_YOUTUBE_API_KEY=
BACKER_YOUTUBE_REGION=US

# Twitch Helix requires a registered application. Prefer a short-lived app token; when it is empty,
# client ID + secret are exchanged server-side through Twitch's official OAuth endpoint.
BACKER_TWITCH_CLIENT_ID=
BACKER_TWITCH_CLIENT_SECRET=
BACKER_TWITCH_APP_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_APP_ACCESS_TOKEN=

# X discovery remains disabled until Backer's commercial use is approved. The trending query is
# server-owned and must comply with Backer's approved API tier and retention policy.
BACKER_X_COMMERCIAL_USE_APPROVED=false
BACKER_X_BEARER_TOKEN=
BACKER_X_TRENDING_QUERY=-is:retweet has:links lang:en

# Meta adapters expose only Page or professional-account IDs explicitly marked authorized in JSON.
# Example: [{"id":"123","name":"Creator","handle":"creator","profileUrl":"https://www.instagram.com/creator/","authorized":true}]
BACKER_META_APP_REVIEW_APPROVED=false
BACKER_META_ACCESS_TOKEN=
META_ACCESS_TOKEN=
BACKER_META_GRAPH_VERSION=v23.0
BACKER_FACEBOOK_PAGES_JSON=[]
BACKER_INSTAGRAM_ACCOUNTS_JSON=[]

# LinkedIn is authorized-self/approved-profile only; arbitrary public profile search is unsupported.
# Example: [{"subject":"oauth-sub","name":"Creator","handle":"creator","profileUrl":"https://www.linkedin.com/in/creator/","authorized":true}]
BACKER_LINKEDIN_APPROVED_ACCESS=false
BACKER_LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
BACKER_LINKEDIN_PROFILES_JSON=[]

# Reviewed feeds are built in. This server-owned JSON can add only entries with verified:true;
# request bodies cannot supply feed URLs. The legacy variable is read only for rollout continuity.
BACKER_DISCOVERY_FEEDS_JSON=[]
BACKER_VERIFIED_PUBLICATION_FEEDS_JSON=[]

# Protected incremental sync. Provider cursors and canonical last-good snapshots persist only when
# DATABASE_URL is configured and migration 005 has run. The external scheduler calls /api/discovery/sync.
BACKER_DISCOVERY_SYNC_PROVIDERS=github,dev,medium,substack,rss
BACKER_DISCOVERY_SYNC_WINDOW_DAYS=30
BACKER_DISCOVERY_SYNC_PAGE_BUDGET=2
BACKER_DISCOVERY_SYNC_PAGE_SIZE=50

# Grounded Responses synthesis automatically turns on when either key is present. Set the flag to
# false to force deterministic local synthesis. All model requests use store:false and strict JSON.
BACKER_DISCOVERY_AI_ENABLED=
BACKER_DISCOVERY_OPENAI_API_KEY=
OPENAI_API_KEY=
BACKER_DISCOVERY_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
BACKER_DISCOVERY_AI_TIMEOUT_MS=4500
